#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Get the current branch name
current_branch="$(git rev-parse --abbrev-ref HEAD)"

# Check if trying to push to protected branches
while read local_ref local_sha remote_ref remote_sha
do
    remote_branch=$(echo "$remote_ref" | sed 's/refs\/heads\///')

    # Prevent direct push to protected branches
    if [ "$remote_branch" = "main" ] || [ "$remote_branch" = "staging" ] || [ "$remote_branch" = "develop" ]; then
        echo "❌ Direct push to '$remote_branch' branch is not allowed!"
        echo ""
        echo "🔒 Protected branches: main, staging, develop"
        echo ""
        echo "These branches represent:"
        echo "  • main    → Production environment"
        echo "  • staging → Staging environment"
        echo "  • develop → Development environment"
        echo ""
        echo "✅ Correct workflow:"
        echo "1. Create a feature branch:"
        echo "   git checkout -b feature/your-feature"
        echo ""
        echo "2. Push your feature branch:"
        echo "   git push origin feature/your-feature"
        echo ""
        echo "3. Create a Pull Request to merge into '$remote_branch'"
        echo ""
        echo "This ensures:"
        echo "  • Code review before merge"
        echo "  • CI/CD checks pass"
        echo "  • Environment integrity maintained"
        echo ""
        exit 1
    fi
done

# Validate branch name format (only for non-protected branches)
valid_branch_regex="^(main|develop|staging)$|^(feature|fix|hotfix|refactor|docs|test|chore)\/[a-z0-9._-]+$"

if ! echo "$current_branch" | grep -qE "$valid_branch_regex"; then
    echo "❌ Invalid branch name: '$current_branch'"
    echo ""
    echo "Branch names must follow this convention:"
    echo "  feature/<description>  - New features"
    echo "  fix/<description>      - Bug fixes"
    echo "  hotfix/<description>   - Critical production fixes"
    echo "  refactor/<description> - Code refactoring"
    echo "  docs/<description>     - Documentation updates"
    echo "  test/<description>     - Test additions/updates"
    echo "  chore/<description>    - Maintenance tasks"
    echo ""
    echo "Examples:"
    echo "  feature/user-authentication"
    echo "  fix/login-validation-bug"
    echo "  docs/api-documentation"
    echo ""
    exit 1
fi
