# Database
DATABASE_URL="postgresql://user:password@localhost:5432/basketball_db?schema=public"

# Auth
JWT_SECRET="your_jwt_secret"
JWT_EXPIRES_IN="7d"

# Optional: comma-separated exact origins (e.g. https://basketball-staging.vercel.app).
# If unset, the API reflects the request Origin (suitable for most setups).
CORS_ORIGINS="app://statdash,https://inhouse.optiqsports.com,https://portal.optiqsports.com,https://broadcast.optiqsports.com"

ADMIN_URL=https://inhouse.optiqsports.com
PORTAL_URL=https://portal.optiqsports.com
BROADCAST_URL=https://broadcast.optiqsports.com
STATDASH_URL=https://inhouse.optiqsports.com

# Cloudinary (Used for Upload Module)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# S3 (Future use)
# AWS_ACCESS_KEY_ID="your_access_key"
# AWS_SECRET_ACCESS_KEY="your_secret_key"
# AWS_S3_BUCKET="your_bucket_name"
# AWS_REGION="your_region"
